# Supabase (opcional: sem isso o app funciona só no aparelho). Use a chave "publishable", nunca a service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# TMDB: "Token de leitura da API" em themoviedb.org/settings/api
TMDB_READ_TOKEN=
# IGDB: credenciais de um app em dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Contato enviado no User-Agent ao Open Library e MusicBrainz (site ou e-mail). Padrão: github.com/mchqueiroz/hobby
CONTACT_URL=

# Endereço público do app (usado em links de compartilhamento e sitemap). Ex.: https://hobby.vercel.app
NEXT_PUBLIC_SITE_URL=
# Contato mostrado na página de Privacidade (e-mail ou site)
NEXT_PUBLIC_CONTACT_URL=
# Link para receber feedback (formulário ou mailto:). Se vazio, o botão não aparece.
NEXT_PUBLIC_FEEDBACK_URL=
